# ═══════════════════════════════════════════════════════════════════════════════
# PHARMA INNOVATION AI - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (add to .gitignore)
#

# ═══════════════════════════════════════════════════════════════════════════════
# API Configuration
# ═══════════════════════════════════════════════════════════════════════════════

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# ═══════════════════════════════════════════════════════════════════════════════
# OpenAI / LLM Configuration (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════════

# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-actual-api-key-here

# LLM Model options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
LLM_MODEL=gpt-4

# Temperature controls randomness (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Maximum tokens per response
LLM_MAX_TOKENS=2048

# API timeout in seconds
LLM_TIMEOUT=30

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# SQLite (default - no setup needed)
DATABASE_URL=sqlite:///./pharma_ai.db

# PostgreSQL example (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/pharma_ai

# MySQL example (if using MySQL)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pharma_ai

DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Cache Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379/0
ENABLE_CACHING=True
CACHE_TTL_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════════
# Monitoring & Logging Configuration
# ═══════════════════════════════════════════════════════════════════════════════

ENABLE_MONITORING=True

# Sentry Error Tracking (Optional)
# Get DSN from: https://sentry.io/
SENTRY_DSN=

# Log level options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# Third-party APIs (Optional - for real data integration)
# ═══════════════════════════════════════════════════════════════════════════════

# PubMed API for scientific literature
PUBMED_API_KEY=

# IQVIA API for market data
IQVIA_API_KEY=

# EXiM API for patent data
EXIM_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Report Generation Configuration
# ═══════════════════════════════════════════════════════════════════════════════

ENABLE_PDF_GENERATION=True
PDF_PAGE_SIZE=letter
PDF_FONT_NAME=Helvetica
PDF_FONT_SIZE=10

# ═══════════════════════════════════════════════════════════════════════════════
# Notes:
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. OPENAI_API_KEY is REQUIRED for the system to work
#
# 2. For development, SQLite is sufficient (default)
#
# 3. For production:
#    - Use PostgreSQL or MySQL instead of SQLite
#    - Enable Redis for caching
#    - Set DEBUG=False
#    - Configure Sentry for error tracking
#
# 4. Don't commit this file to version control
#    Add this to .gitignore: .env
#
# 5. Keep API keys private and secure
#
# ═══════════════════════════════════════════════════════════════════════════════
